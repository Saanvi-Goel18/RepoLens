# Backend Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to git.

# GitHub Personal Access Token
# Required for higher API rate limits (5000/hr vs 60/hr unauthenticated).
# Generate one at: https://github.com/settings/tokens
# Scopes needed: none (for public repos) — just create a classic token with no scopes
GITHUB_TOKEN=your_github_token_here

# Groq API Key (free at https://console.groq.com)
# Used for LLM analysis via llama-3.3-70b-versatile
GROQ_API_KEY=gsk_your_groq_key_here

# Server Port (optional, defaults to 3001)
PORT=3001

# Frontend URL for CORS and OAuth redirect
FRONTEND_URL=http://localhost:5173

# GitHub OAuth App (For Private Repo Scanning)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
