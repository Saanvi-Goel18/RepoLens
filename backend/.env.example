# Backend Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to git.

# GitHub Personal Access Token
# Required for higher API rate limits (5000/hr vs 60/hr unauthenticated).
# Generate one at: https://github.com/settings/tokens
# Scopes needed: none (for public repos) — just create a classic token with no scopes
GITHUB_TOKEN=your_github_token_here

# OpenAI API Key
# Required for the LLM analysis layer (GPT-4o-mini).
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_key_here

# Server Port (optional, defaults to 3001)
PORT=3001

# Frontend URL for CORS (optional, defaults to http://localhost:5173)
# Set this to your deployed Vercel URL in production.
FRONTEND_URL=http://localhost:5173
