# Frontend Environment Variables
# Copy this file to .env.local and fill in your value.
# Vite reads variables prefixed with VITE_ and exposes them to the browser.

# URL of the RepoLens backend API.
# For local development this defaults to http://localhost:3001 — no need to set it.
# For production, set this to your deployed backend URL (e.g. https://repolens-api.onrender.com)
VITE_BACKEND_URL=http://localhost:3001
